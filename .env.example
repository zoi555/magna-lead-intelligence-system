# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# Supabase. Use separate UAT and production projects.
# aspectlead-platform project ref (not a secret): rubhjkgygauuixiqouza
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE ROLE KEY IS SECRET — server/worker only, never NEXT_PUBLIC_, never commit real value.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AWS / serverless processing
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LAMBDA_FUNCTION_PREFIX=
AWS_BUDGET_ALERT_EMAIL=

# --- Territory selection ---
# Which outcodes the pipeline searches. Default `pilot` (MVP test set — NOT national).
#   pilot            = UB1,UB2,UB6,HA0,HA9,W5 (temporary test)
#   vp_coverage      = reads imports/vp-postcodes.csv | magna-coverage-postcodes.csv | target-postcodes.csv
#   full_uk_outcodes = national (requires imports/uk-outcodes.csv; batched/cached — do not blind-scan)
#   custom_upload    = reads imports/custom-postcodes.csv | target-postcodes.csv
TERRITORY_MODE=pilot

# Data sources
# --- FSA (Food Standards Agency) — FREE / OPEN, no key. Header x-api-version: 2. ---
FSA_API_BASE_URL=https://api.ratings.food.gov.uk

# --- Just Eat (PRIMARY live platform source) — public discovery endpoint, server-side only. ---
# Off by default. Set to true to allow the live pull. No key required.
JUST_EAT_ENABLED=false
JUST_EAT_MAX_CALLS_PER_RUN=50
JUST_EAT_REQUEST_DELAY_MS=500

# --- Companies House — status gate. Free API key from developer.company-information.service.gov.uk. ---
# Off by default. Used only to HOLD high-confidence dissolved companies; never to
# exclude a lead for "no match" (sole traders/trading names have no company record).
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_ENABLED=false
COMPANIES_HOUSE_MAX_CALLS_PER_RUN=100

# --- Google Places — NOT a priority (paid). Left disabled. ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false

APIFY_TOKEN=
JUSTEAT_ENDPOINT_BASE_URL=

# CRM / exports. Do not add real production credentials here.
MAGNA_SALES_PRO_BASE_URL=
MAGNA_SALES_PRO_API_KEY=
MAGNA_SALES_PRO_IMPORT_MODE=manual_review

# Optional storage/reference
GOOGLE_DRIVE_FOLDER_ID=

# Never commit real values. If this file contains a real secret, something has gone deeply, embarrassingly wrong.
