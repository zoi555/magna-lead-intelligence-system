    "next": "^16.2.10",
    "pmtiles": "^4.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.4.19",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "3.4.7",
    "tsx": "^4.19.2",
    "typescript": "5.5.4"
  },
  "overrides": {
    "postcss": "^8.5.16"
  }
