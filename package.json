{
  "name": "lead-intelligence-app-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Lead Intelligence Platform — SaaS-neutral app shell (mock data only, not production).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "leads:first": "tsx scripts/run-first-fsa-leads.ts",
    "leads:resume": "tsx scripts/run-first-fsa-leads.ts --resume",
    "leads:status": "tsx scripts/run-first-fsa-leads.ts --status",
    "leads:analyse": "tsx scripts/analyse-first-leads.ts",
    "test:scoring": "tsx scripts/test-scoring-samples.ts",
    "test:telesales-safe": "tsx scripts/test-telesales-safe-view.ts",
    "leads:just-eat": "tsx scripts/fetch-just-eat.ts",
    "leads:tw-platform-first": "tsx scripts/run-tw-platform-first-leads.ts",
    "test:geo": "tsx scripts/test-geo-foundation.ts",
    "geo:glyphs": "node scripts/geo/gen-glyphs.js",
    "geo:install": "bash scripts/geo/00-install-tools.sh",
    "geo:acquire": "bash scripts/geo/10-acquire-national-geo.sh",
    "geo:convert": "bash scripts/geo/20-convert-national-geo.sh",
    "geo:link": "mkdir -p public/map/tiles && for f in \"$HOME\"/Data/aspectlead-geospatial/tiles/*.pmtiles; do ln -sf \"$f\" \"public/map/tiles/$(basename \"$f\")\"; done && ls -la public/map/tiles",
    "test:run-draft": "tsx scripts/test-run-draft.ts",
    "test:custom-config": "tsx scripts/test-custom-config.ts",
    "test:je-stage1": "tsx scripts/test-je-stage1.ts",
    "test:je-supabase": "tsx scripts/test-je-supabase.ts",
    "je:worker": "tsx scripts/je-worker.ts",
    "seed:postcode-reference": "tsx scripts/seed-postcode-reference.ts",
    "test:geography-standard": "tsx scripts/test-geography-standard.ts",
    "test:multi-source": "tsx scripts/test-multi-source.ts",
    "test:uber-parse": "tsx scripts/test-uber-parse.ts",
    "ingest:os-open-names": "tsx scripts/ingest-os-open-names.ts",
    "je:run": "tsx scripts/je-run.ts",
    "uber:pilot": "tsx scripts/uber-pilot.ts"
